{
  "name": "saude-unificada-infra",
  "version": "0.1.0",
  "description": "Infraestrutura AWS da Saúde Unificada como código (AWS CDK)",
  "private": true,
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff --all",
    "bootstrap": "cdk bootstrap",
    "deploy": "cdk deploy --all --require-approval never",
    "deploy:api": "cdk deploy SaudeUnificadaApi --require-approval never",
    "destroy:api": "cdk destroy SaudeUnificadaApi --force",
    "destroy:all": "cdk destroy --all --force",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1147.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
