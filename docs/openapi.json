{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Devolve o token JWT e os dados do usuário. A senha nunca aparece na resposta.",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "E-mail em formato inválido ou senha vazia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 400,
                  "message": "Informe um e-mail válido."
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 401,
                  "message": "E-mail ou senha inválidos."
                }
              }
            }
          }
        },
        "summary": "Login de profissional de saúde ou gestor",
        "tags": [
          "Autenticação"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Sem token, token inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 401,
                  "message": "Faça login para continuar."
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Dados do usuário logado",
        "tags": [
          "Autenticação"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Responde 200 com tudo funcionando e 503 se o MongoDB estiver fora. Usado pelos alarmes do CloudWatch.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "MongoDB fora do ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "summary": "Status da API e do MongoDB",
        "tags": [
          "Saúde"
        ]
      }
    },
    "/api/health/live": {
      "get": {
        "description": "Usado pelo health check do load balancer: uma queda rápida do MongoDB não deve fazer a AWS derrubar e recriar as instâncias da API.",
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        },
        "summary": "A API está de pé (não consulta o banco)",
        "tags": [
          "Saúde"
        ]
      }
    },
    "/api/patients/{cpf}": {
      "get": {
        "description": "Busca pelo CPF (com ou sem máscara). O acesso é registrado na auditoria (LGPD).",
        "operationId": "PatientsController_getRecord",
        "parameters": [
          {
            "name": "cpf",
            "required": true,
            "in": "path",
            "description": "CPF do paciente, só dígitos ou com máscara (229.169.264-02)",
            "schema": {
              "example": "22916926402",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientResponse"
                }
              }
            }
          },
          "400": {
            "description": "CPF inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 400,
                  "message": "CPF inválido."
                }
              }
            }
          },
          "401": {
            "description": "Sem token, token inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 401,
                  "message": "Faça login para continuar."
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (só médicos acessam prontuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 403,
                  "message": "Seu perfil não tem permissão para acessar este recurso."
                }
              }
            }
          },
          "404": {
            "description": "Nenhum paciente com este CPF (o site oferece o cadastro)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 404,
                  "message": "Paciente não encontrado."
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Prontuário unificado do paciente",
        "tags": [
          "Pacientes"
        ]
      }
    },
    "/api/patients": {
      "post": {
        "description": "Cria o prontuário com as listas vazias. Alergias, medicamentos e condições entram depois, pelos atendimentos.",
        "operationId": "PatientsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePatientDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PatientResponse"
                }
              }
            }
          },
          "400": {
            "description": "CPF inválido ou campo obrigatório faltando/inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 400,
                  "message": "CPF inválido."
                }
              }
            }
          },
          "401": {
            "description": "Sem token, token inválido ou expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 401,
                  "message": "Faça login para continuar."
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (só médicos acessam prontuários)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 403,
                  "message": "Seu perfil não tem permissão para acessar este recurso."
                }
              }
            }
          },
          "409": {
            "description": "CPF já cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "statusCode": 409,
                  "message": "Já existe um paciente cadastrado com este CPF."
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Cadastra um paciente",
        "tags": [
          "Pacientes"
        ]
      }
    }
  },
  "info": {
    "title": "Saúde Unificada — API",
    "description": "API da plataforma **Saúde Unificada**: prontuário unificado por CPF, usada pelo site (médicos e gestores) e pelo app (pacientes).\n\n**Como testar por aqui**\n1. Abra *Autenticação → POST /api/auth/login* e clique em **Execute** (o exemplo já vem com o médico de teste).\n2. Copie o `token` da resposta, clique em **Authorize** (cadeado no topo) e cole o token.\n3. As outras rotas passam a mandar o token automaticamente (ele fica salvo mesmo se a página recarregar).\n\n**Usuários de teste** (ambiente de desenvolvimento e demonstração), senha `123456`:\n- `medico@teste.com`: médico (Clínica Médica)\n- `cardio@teste.com`: médica (Cardiologia)\n- `gestor@teste.com`: gestora pública\n\nErros sempre voltam como `{ \"statusCode\": 401, \"message\": \"...\" }`, com a mensagem em português.\nContrato completo: `docs/API_CONTRACT.md`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Autenticação",
      "description": "Login e dados do usuário logado"
    },
    {
      "name": "Pacientes",
      "description": "Cadastro e prontuário unificado por CPF (só médicos; acessos auditados)"
    },
    {
      "name": "Saúde",
      "description": "Status da API e do banco (monitoramento e load balancer)"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Token devolvido pelo login"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "medico@teste.com"
          },
          "password": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80912"
          },
          "name": {
            "type": "string",
            "example": "Dr. Rafael Moreira Lima"
          },
          "email": {
            "type": "string",
            "example": "medico@teste.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "medico",
              "gestor"
            ],
            "example": "medico"
          },
          "crm": {
            "type": "string",
            "example": "CRM-SP 123456",
            "description": "Só para médicos"
          },
          "specialty": {
            "type": "string",
            "example": "Clínica Médica",
            "description": "Só para médicos"
          },
          "phone": {
            "type": "string",
            "example": "(11) 3456-7890"
          },
          "institution": {
            "type": "string",
            "example": "UBS Vila Mariana",
            "description": "Unidade de saúde (médico) ou órgão (gestor)"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "JWT para o header Authorization"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "E-mail ou senha inválidos.",
            "description": "Mensagem em português, exibida ao usuário"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "erro"
            ],
            "example": "ok"
          },
          "mongodb": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up",
            "description": "Conexão com o MongoDB"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 3600,
            "description": "Segundos desde que a API subiu"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-11-05T03:00:00.000Z"
          }
        },
        "required": [
          "status",
          "mongodb",
          "uptimeSeconds",
          "timestamp"
        ]
      },
      "LiveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "AllergyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80a01"
          },
          "substance": {
            "type": "string",
            "example": "Penicilina"
          },
          "severity": {
            "type": "string",
            "enum": [
              "leve",
              "moderada",
              "grave"
            ],
            "example": "grave"
          },
          "reaction": {
            "type": "string",
            "example": "Anafilaxia"
          },
          "recordedAt": {
            "type": "string",
            "example": "2015-06-02",
            "description": "AAAA-MM-DD"
          }
        },
        "required": [
          "id",
          "substance",
          "severity",
          "recordedAt"
        ]
      },
      "MedicationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80a02"
          },
          "name": {
            "type": "string",
            "example": "Losartana potássica"
          },
          "dosage": {
            "type": "string",
            "example": "50 mg"
          },
          "frequency": {
            "type": "string",
            "example": "1x ao dia"
          },
          "startDate": {
            "type": "string",
            "example": "2018-04-10",
            "description": "AAAA-MM-DD"
          },
          "prescribedBy": {
            "type": "string",
            "example": "Dr. Rafael Moreira Lima"
          }
        },
        "required": [
          "id",
          "name",
          "dosage",
          "frequency",
          "startDate"
        ]
      },
      "ProcedureResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80a03"
          },
          "name": {
            "type": "string",
            "example": "Colecistectomia videolaparoscópica"
          },
          "date": {
            "type": "string",
            "example": "2016-09-12",
            "description": "AAAA-MM-DD"
          },
          "location": {
            "type": "string",
            "example": "Hospital das Clínicas - SP"
          },
          "notes": {
            "type": "string",
            "example": "Sem intercorrências"
          }
        },
        "required": [
          "id",
          "name",
          "date"
        ]
      },
      "ExamResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80a04"
          },
          "name": {
            "type": "string",
            "example": "Hemoglobina glicada (HbA1c)"
          },
          "date": {
            "type": "string",
            "example": "2026-07-18",
            "description": "AAAA-MM-DD"
          },
          "result": {
            "type": "string",
            "example": "7,1% — acima da meta"
          },
          "fileName": {
            "type": "string",
            "example": "hba1c_jul2026.pdf"
          }
        },
        "required": [
          "id",
          "name",
          "date",
          "result"
        ]
      },
      "ClinicalConditionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80a05"
          },
          "name": {
            "type": "string",
            "example": "Hipertensão arterial sistêmica"
          },
          "cid": {
            "type": "string",
            "example": "I10",
            "description": "Código CID-10"
          },
          "diagnosedAt": {
            "type": "string",
            "example": "2018-04-10",
            "description": "AAAA-MM-DD"
          },
          "status": {
            "type": "string",
            "enum": [
              "ativa",
              "controlada",
              "resolvida"
            ],
            "example": "controlada"
          }
        },
        "required": [
          "id",
          "name",
          "diagnosedAt",
          "status"
        ]
      },
      "AppointmentSummaryResponse": {
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "string",
            "example": "6729f1c2a3b4c5d6e7f80b01"
          },
          "date": {
            "type": "string",
            "example": "2026-08-02T12:00:00.000Z"
          },
          "doctorName": {
            "type": "string",
            "example": "Dr. Rafael Moreira Lima"
          },
          "specialty": {
            "type": "string",
            "example": "Clínica Médica"
          },
          "summary": {
            "type": "string",
            "example": "PA 132/84 mmHg. Mantida conduta."
          }
        },
        "required": [
          "appointmentId",
          "date",
          "doctorName",
          "summary"
        ]
      },
      "PatientResponse": {
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string",
            "example": "22916926402",
            "description": "Só dígitos"
          },
          "fullName": {
            "type": "string",
            "example": "Maria Aparecida da Silva"
          },
          "birthDate": {
            "type": "string",
            "example": "1958-03-14",
            "description": "AAAA-MM-DD"
          },
          "sex": {
            "type": "string",
            "enum": [
              "F",
              "M",
              "Outro"
            ],
            "example": "F"
          },
          "bloodType": {
            "type": "string",
            "enum": [
              "A+",
              "A-",
              "B+",
              "B-",
              "AB+",
              "AB-",
              "O+",
              "O-",
              "Não informado"
            ],
            "example": "O-"
          },
          "phone": {
            "type": "string",
            "example": "(11) 98765-4321"
          },
          "email": {
            "type": "string",
            "example": "maria.silva@email.com"
          },
          "region": {
            "type": "string",
            "enum": [
              "Grande São Paulo",
              "Campinas",
              "Baixada Santista",
              "Vale do Paraíba",
              "Sorocaba",
              "Ribeirão Preto"
            ],
            "example": "Grande São Paulo"
          },
          "allergies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllergyResponse"
            }
          },
          "activeMedications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MedicationResponse"
            }
          },
          "procedures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProcedureResponse"
            }
          },
          "exams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExamResponse"
            }
          },
          "clinicalConditions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClinicalConditionResponse"
            }
          },
          "appointmentSummaries": {
            "description": "Só atendimentos realizados, do mais recente para o mais antigo (preenchido a partir do bloco 7)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppointmentSummaryResponse"
            }
          }
        },
        "required": [
          "cpf",
          "fullName",
          "birthDate",
          "sex",
          "bloodType",
          "region",
          "allergies",
          "activeMedications",
          "procedures",
          "exams",
          "clinicalConditions",
          "appointmentSummaries"
        ]
      },
      "CreatePatientDto": {
        "type": "object",
        "properties": {
          "cpf": {
            "type": "string",
            "example": "81646027876",
            "description": "Só dígitos ou com a máscara 816.460.278-76. Precisa ter dígitos verificadores válidos; CPFs de exemplo conhecidos são recusados."
          },
          "fullName": {
            "type": "string",
            "example": "Fulano de Tal",
            "maxLength": 120
          },
          "birthDate": {
            "type": "string",
            "example": "1990-05-10",
            "description": "AAAA-MM-DD, não pode ser no futuro"
          },
          "sex": {
            "type": "string",
            "enum": [
              "F",
              "M",
              "Outro"
            ],
            "example": "M"
          },
          "bloodType": {
            "type": "string",
            "enum": [
              "A+",
              "A-",
              "B+",
              "B-",
              "AB+",
              "AB-",
              "O+",
              "O-",
              "Não informado"
            ],
            "example": "Não informado"
          },
          "phone": {
            "type": "string",
            "example": "(19) 99999-0000",
            "description": "Vazio (\"\") é tratado como não informado"
          },
          "email": {
            "type": "string",
            "example": "fulano@email.com",
            "description": "Vazio (\"\") é tratado como não informado"
          },
          "region": {
            "type": "string",
            "enum": [
              "Grande São Paulo",
              "Campinas",
              "Baixada Santista",
              "Vale do Paraíba",
              "Sorocaba",
              "Ribeirão Preto"
            ],
            "example": "Campinas"
          }
        },
        "required": [
          "cpf",
          "fullName",
          "birthDate",
          "sex",
          "bloodType",
          "region"
        ]
      }
    }
  }
}
