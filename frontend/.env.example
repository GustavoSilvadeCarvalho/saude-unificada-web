# Copie para .env. "false" usa a API real; "true" (ou sem .env) usa os dados fixos de src/mocks, sem precisar da API
VITE_USE_MOCK=false
# URL base da API. Local: http://localhost:3000/api (backend com "npm run dev:memory").
# AWS: https://dxxxxxxxx.cloudfront.net/api (saída ApiUrl do deploy em infra/)
VITE_API_URL=http://localhost:3000/api
# "true" mostra os usuários de teste na tela de login também no site publicado (demonstração)
VITE_SHOW_TEST_USERS=false
