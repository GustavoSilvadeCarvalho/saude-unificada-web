# Porta HTTP da API (as rotas ficam em http://localhost:PORT/api)
PORT=3000

# MongoDB. Precisa ser replica set (o Atlas já é), porque o registro de
# atendimento usa transação. Para rodar sem instalar nada: npm run dev:memory
MONGODB_URI=mongodb://localhost:27017/saude-unificada?replicaSet=rs0
# Só para MongoDB sem replica set (desliga a transação do registro de atendimento). Nunca em produção.
# MONGODB_TRANSACTIONS=false

# Segredo para assinar os tokens JWT. Troque em produção!
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS, separadas por vírgula (front local e Vercel)
CORS_ORIGINS=http://localhost:5173

# Pasta onde os arquivos enviados (receitas, laudos) são gravados
UPLOAD_DIR=uploads

# Swagger em /api/docs (false para desligar)
SWAGGER_ENABLED=true
