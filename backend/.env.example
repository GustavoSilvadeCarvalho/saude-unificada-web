# Porta HTTP da API (as rotas ficam em http://localhost:PORT/api)
PORT=3000

# MongoDB. Precisa ser replica set (o Atlas já é), porque o registro de
# atendimento usa transação. Para rodar sem instalar nada: npm run dev:memory
MONGODB_URI=mongodb://localhost:27017/saude-unificada?replicaSet=rs0
# Só para MongoDB sem replica set (desliga a transação do registro de atendimento). Nunca em produção.
# MONGODB_TRANSACTIONS=false

# Segredo para assinar os tokens JWT. Troque em produção!
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS, separadas por vírgula (front local e Vercel)
CORS_ORIGINS=http://localhost:5173

# Onde ficam os arquivos enviados (receitas, laudos): local (pasta UPLOAD_DIR) ou s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Driver s3: bucket e região. Credenciais NÃO vão aqui: vêm da role da AWS (ECS/EC2) ou do perfil da AWS CLI
# S3_BUCKET=saude-unificada-docs
# AWS_REGION=sa-east-1
# Só para testar com S3 compatível (MinIO/LocalStack)
# S3_ENDPOINT=http://localhost:9000
# Endereço público da API, usado nos links de download do driver local (padrão: o host da requisição)
# PUBLIC_API_URL=http://localhost:3000

# Quantos proxies ficam na frente da API (CloudFront + ALB na AWS = 2; local = 0).
# Define de onde sai o IP do cliente usado no limite de tentativas de login
TRUST_PROXY=0

# Tentativas de entrada (login e primeiro acesso) por minuto: por IP + conta e só por IP.
# 0 desliga (só no teste de carga)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_IP=30

# Swagger em /api/docs (false para desligar)
SWAGGER_ENABLED=true
